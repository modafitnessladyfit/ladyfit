# Copie este arquivo para ".env" e preencha com os valores do seu projeto Supabase
# (Project Settings > API). Nunca commite o ".env" real.

# Cliente (seguro para expor no browser; protegido por Row Level Security)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Servidor apenas — bypassa RLS. NUNCA prefixar com VITE_.
SUPABASE_SECRET_KEY=
